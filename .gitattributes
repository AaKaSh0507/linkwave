# =============================================================================
# LinkWave - Git Attributes
# Consistent line endings and diff behavior
# =============================================================================

# Default: auto-detect and normalize
* text=auto eol=lf

# Scripts
*.sh text eol=lf

# Java
*.java text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf

# Config
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.svg text eol=lf

# Documentation
*.md text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf

# SQL
*.sql text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.jar binary

# syntax=docker/dockerfile:1.4

# =============================================================================
# LINKWAVE FRONTEND - Production Dockerfile
# Next.js 16 with Node.js - Standalone output with security hardening
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependencies
# -----------------------------------------------------------------------------
FROM node:20-alpine AS deps

WORKDIR /app

# Install libc6-compat for Alpine compatibility
RUN apk add --no-cache libc6-compat

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies with cache mount
RUN --mount=type=cache,target=/root/.npm \
    npm ci --only=production

# -----------------------------------------------------------------------------
# Stage 2: Builder
# -----------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy all dependencies for build
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Install all dependencies including dev for build
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Set build-time environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}
ENV NEXT_TELEMETRY_DISABLED=1

# Build with standalone output
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 3: Production Runtime (minimal)
# -----------------------------------------------------------------------------
FROM node:20-alpine AS production

LABEL maintainer="LinkWave Team" \
    version="1.0" \
    description="LinkWave Frontend Application"

WORKDIR /app

# Install security updates and minimal deps
RUN apk add --no-cache libc6-compat wget tzdata && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -u 1001 -S nextjs -G nodejs

# Set timezone
ENV TZ=UTC

# Copy only necessary files for production
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

CMD ["node", "server.js"]

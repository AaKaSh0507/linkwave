# =============================================================================
# LinkWave - Git Ignore Configuration
# Production-grade ignore patterns for Spring Boot + Next.js monorepo
# =============================================================================

# =============================================================================
# ENVIRONMENT & SECRETS (CRITICAL - Never commit these!)
# =============================================================================
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
secrets/
credentials/

# =============================================================================
# OPERATING SYSTEM
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# IDE & EDITORS
# =============================================================================
# JetBrains (IntelliJ IDEA, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.project
.classpath
.settings/
.metadata/
bin/
tmp/
*.tmp
*.bak

# NetBeans
nbproject/private/
nbbuild/
nbdist/
nbactions.xml
nb-configuration.xml

# Vim/Neovim
*.swp
*.swo
*.swn
*~
.netrwhist
tags

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# =============================================================================
# JAVA / SPRING BOOT / GRADLE (Backend)
# =============================================================================
# Gradle
backend/.gradle/
backend/build/
!backend/gradle/wrapper/gradle-wrapper.jar
!backend/gradle/wrapper/gradle-wrapper.properties

# Compiled files
*.class
*.jar
!backend/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.nar

# Package files
*.zip
*.tar.gz
*.rar

# Build outputs
backend/out/
backend/target/
backend/bin/
!backend/bin/generated-sources/
!backend/bin/generated-test-sources/

# Spring Boot
backend/*.log
backend/logs/
spring-boot-*.log

# JVM crash logs
hs_err_pid*
replay_pid*

# Annotation processing
backend/.apt_generated/
backend/.apt_generated_tests/

# =============================================================================
# JAVASCRIPT / TYPESCRIPT / NEXT.JS (Frontend)
# =============================================================================
# Dependencies
frontend/node_modules/
node_modules/

# Next.js
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.vercel/

# Build outputs
frontend/build/
frontend/dist/
frontend/.cache/

# TypeScript
frontend/*.tsbuildinfo
frontend/.tsbuildinfo
*.tsbuildinfo

# Parcel/Webpack
.cache/
.parcel-cache/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
frontend/coverage/
frontend/.nyc_output/
*.lcov

# Misc
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/sdks
!frontend/.yarn/versions

# Storybook
frontend/storybook-static/

# PWA
frontend/public/sw.js
frontend/public/workbox-*.js

# =============================================================================
# DOCKER
# =============================================================================
# SSL certificates (generated locally)
docker/nginx/ssl/
docker/nginx/certs/

# Docker volumes data (if mounted locally)
docker/data/
docker/volumes/

# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================
*.log
logs/
*.tmp
*.temp
*.bak
*.backup
*.orig

# =============================================================================
# TEST & COVERAGE
# =============================================================================
coverage/
.coverage
htmlcov/
.tox/
.pytest_cache/
.hypothesis/
*.cover
*.py[cod]

# JUnit reports
backend/build/reports/
backend/build/test-results/
test-results/
surefire-reports/

# =============================================================================
# DATABASE & STORAGE
# =============================================================================
*.db
*.sqlite
*.sqlite3
*.h2.db
*.mv.db
*.trace.db

# Redis dump
dump.rdb

# =============================================================================
# BACKUPS
# =============================================================================
backups/
*.sql.gz
*.dump

# =============================================================================
# MISCELLANEOUS
# =============================================================================
# Local configuration overrides
*.local
local/
local.*

# Generated documentation
docs/_build/
site/

# Terraform (if used)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Python (if used for scripts)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
ENV/
.venv/

# Pre-commit cache (optional - can be large)
# .pre-commit/

# Profiling
*.prof
*.hprof

# =============================================================================
# EXPLICITLY TRACKED (Override ignores above)
# =============================================================================
# Keep these files even if they match patterns above
!.gitkeep
!.npmrc
!.nvmrc
!.node-version
!Makefile
!Dockerfile*
!docker-compose*.yml
!*.example
!*.template
!*.sample
